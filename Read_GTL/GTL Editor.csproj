<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Product>GTL Text Editor</Product>
    <AssemblyTitle>GTL Text Editor</AssemblyTitle>
    <AssemblyName>GTL Text Editor</AssemblyName>
    <Version>1.11.0.0</Version>
    <AssemblyVersion>1.11.0.0</AssemblyVersion>
    <FileVersion>1.11.0.0</FileVersion>
    <ApplicationIcon>GTL Text Editor.ico</ApplicationIcon>
    <NoWarn>$(NoWarn);WFO1000;CA1416;CS8981;SYSLIB0012;CS0649;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\gtlDisplay\gtlDisplayControl.csproj" />
    <ProjectReference Include="..\postitionDisplayControl\positionDisplayControl.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="GTL Text Editor.ico" />
    <Content Include="Resources\AntiAlias-Off.bmp" />
    <None Include="Eyedropper.cur">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="Resources\Eyedropper.cur">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      <CustomToolNamespace>Read_GTL</CustomToolNamespace>
    </EmbeddedResource>
  </ItemGroup>
</Project>